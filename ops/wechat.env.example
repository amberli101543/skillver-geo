# ============================================================
# 微信公众号凭证（只填下面两行等号右边）
# ============================================================
# 1. 复制本文件到仓库根目录，并改名为 .env.wechat：
#      cp ops/wechat.env.example .env.wechat
# 2. 打开 .env.wechat，在等号后面粘贴你的值（不要加引号、不要发到聊天）
# 3. 保存后即可运行 scripts/wechat_draft_publish.py
#
# AppID / AppSecret 在哪里看：
#   微信公众平台 → 设置与开发 → 开发接口管理 → 基本配置
# ============================================================

# ↓↓↓ 把你的 AppID 粘贴到等号右边（示例：wxabcdef1234567890）
WECHAT_APP_ID=

# ↓↓↓ 把你的 AppSecret 粘贴到等号右边（你说的 appkey 一般就是这个）
WECHAT_APP_SECRET=

# 作者名（可改可不改）
WECHAT_AUTHOR=Skillver

# ↓↓↓ 固定封面：先在公众平台素材库上传图片，再运行
#   python3 scripts/wechat_draft_publish.py --list-images
# 把输出的 media_id 粘贴到等号右边（脚本不生成封面）
WECHAT_THUMB_MEDIA_ID=

# 完整步骤见：docs/WECHAT-DRAFT-AUTOMATION.md
