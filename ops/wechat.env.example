# ============================================================
# 微信公众号凭证模板（可提交；不要在此填写真实密钥）
# ============================================================
# 1. 复制到仓库根目录并改名：
#      cp ops/wechat.env.example .env.wechat
# 2. 只在 .env.wechat 填写真实 AppID / AppSecret / THUMB_MEDIA_ID
# 3. .env.wechat 已被 gitignore，勿提交、勿发到聊天
#
# AppID / AppSecret：微信公众平台 → 设置与开发 → 基本配置
# 完整步骤：docs/WECHAT-DRAFT-AUTOMATION.md
# ============================================================

WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_AUTHOR=Skillver
WECHAT_THUMB_MEDIA_ID=
