# Copy to backend/.env and adjust. Never commit the real .env (see .gitignore).
DATABASE_URL="postgresql://geo:geo@localhost:5433/geo_studio?schema=public"
PORT=3000

# Studio login (required in production)
STUDIO_USERNAME=admin
STUDIO_PASSWORD=123456

# API protection (required in production; also used as JWT signing fallback)
API_AUTH_TOKEN=dev-key

# Optional overrides
# JWT_SECRET=your-jwt-secret
# OPENAI_API_KEY=sk-...
# WEB_ORIGIN=http://localhost:5173

# Diagnostic engines (all optional; connectors fall back to stub without keys)
# See docs/CONNECTORS.md. With 9 registered engines, set DIAGNOSTIC_ENGINE_IDS to control batch cost.
# DIAGNOSTIC_ENGINE_IDS=doubao,kimi,deepseek,yuanbao,chatgpt
# PERPLEXITY_API_KEY=pplx-...
# DOUBAO_API_KEY=...            # 火山方舟 Ark；DOUBAO_MODEL 填模型 ID 或 ep-* 接入点
# KIMI_API_KEY=sk-...           # 或 MOONSHOT_API_KEY
# DEEPSEEK_API_KEY=sk-...
# YUANBAO_API_KEY=sk-...        # 腾讯 TokenHub Key（或 HUNYUAN_API_KEY）
# GEMINI_API_KEY=...            # 或 GOOGLE_API_KEY
# CHATGPT_API_KEY=sk-...        # 或复用 OPENAI_API_KEY
# CLAUDE_API_KEY=sk-ant-...     # 或 ANTHROPIC_API_KEY
