{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skillver.cn/schemas/geo/channel-content.schema.json",
  "title": "Skillver GEO 渠道发布资产",
  "type": "object",
  "required": ["schemaVersion", "items"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "items": {
      "type": "array",
      "minItems": 24,
      "items": {
        "type": "object",
        "required": [
          "contentId", "cellId", "channel", "title", "status",
          "sourceMaster", "scheduledAt", "markdownPath", "cmsHtmlPath"
        ],
        "additionalProperties": false,
        "properties": {
          "contentId": {
            "type": "string",
            "pattern": "^GEO-20[0-9]{4}-C(0[1-9]|1[0-6])(?:-[A-Z0-9]+)?-(TCODEAI|MAIN-FAQ|WECHAT|XHS|ZHIHU)$"
          },
          "cellId": {
            "type": "string",
            "pattern": "^C(0[1-9]|1[0-6])$"
          },
          "channel": {
            "type": "string",
            "enum": ["tcodeai", "main-faq", "wechat", "xiaohongshu", "zhihu"]
          },
          "title": {"type": "string", "minLength": 1},
          "status": {"type": "string", "enum": ["draft", "approved"]},
          "sourceMaster": {
            "type": "string",
            "pattern": "^content/C(0[1-9]|1[0-6])-.+\\.md$"
          },
          "scheduledAt": {
            "type": "string",
            "pattern": "^20[0-9]{2}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])$"
          },
          "markdownPath": {
            "type": "string",
            "pattern": "^content/publish-ready/C(0[1-9]|1[0-6])/(?:[A-Z0-9]+/)?(tcodeai|main-faq|wechat|xiaohongshu|zhihu)\\.md$"
          },
          "cmsHtmlPath": {
            "type": ["string", "null"],
            "pattern": "^content/publish-ready/C(0[1-9]|1[0-6])/(?:[A-Z0-9]+/)?cms/(tcodeai|main-faq)\\.html$"
          },
          "publishedAt": {
            "type": "string",
            "pattern": "^20[0-9]{2}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])$"
          },
          "publishedUrl": {"type": "string", "pattern": "^https://.+$"}
        }
      }
    }
  }
}
