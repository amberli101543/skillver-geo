{
  "version": "1.1.0",
  "canonicalPositioning": "全面开放注册；邀请码仅用于赛事参与",
  "scanPaths": [
    "README.md",
    "TODO-skillver-geo.md",
    "01-strategy",
    "04-channels",
    "content"
  ],
  "allowedClaims": [
    {
      "id": "ALLOW_OPEN_SIGNUP",
      "description": "网站已全面开放注册，用户可直接官网自助注册，注册不再需要邀请码。",
      "patterns": [
        "全面开放注册",
        "开放注册",
        "公开注册",
        "自助注册",
        "可直接注册",
        "无需邀请码即可注册",
        "注册已开放",
        "注册不再需要邀请码"
      ]
    },
    {
      "id": "ALLOW_EVENT_INVITE",
      "description": "邀请码仅用于赛事/竞赛参与，不作为注册门槛。",
      "patterns": [
        "邀请码仅用于赛事",
        "赛事邀请码",
        "参赛邀请码",
        "竞赛邀请码",
        "赛事参与的邀请码"
      ]
    }
  ],
  "prohibitedClaims": [
    {
      "id": "BLOCK_INVITE_FOR_SIGNUP",
      "description": "不得再将邀请码描述为注册或产品准入门槛。",
      "patterns": [
        "邀请码准入",
        "(?<!不)需要邀请码才能注册",
        "(?<!不)需要邀请码才能进入",
        "持邀请码即可注册",
        "持邀请码注册",
        "通过邀请码注册",
        "实行邀请码准入",
        "采用邀请码准入"
      ]
    },
    {
      "id": "BLOCK_CLOSED_BETA_ACCESS",
      "description": "不得将当前阶段描述为仍需封闭内测或邀请才能注册使用。",
      "patterns": [
        "当前处于 ICP 封闭内测",
        "当前处于封闭内测",
        "当前是 ICP 封闭内测",
        "处于 ICP 封闭内测",
        "ICP 封闭内测，采用",
        "ICP 封闭内测，实行",
        "封闭内测、邀请码",
        "封闭内测，邀请码",
        "并未面向所有人公开开放"
      ]
    }
  ],
  "pendingVerificationClaims": [
    {
      "id": "VERIFY_PRICE",
      "description": "免费、零收费、价格或折扣声明发布前必须由业务事实源确认。",
      "patterns": [
        "免费",
        "零收费",
        "价格",
        "折扣"
      ]
    },
    {
      "id": "VERIFY_USAGE_COUNT",
      "description": "体验次数、名额或额度等具体数量发布前必须核实。",
      "patterns": [
        "[0-9一二三四五六七八九十百千]+\\s*(次|个)?\\s*(体验|名额|额度)",
        "(体验|名额|额度)\\s*[0-9一二三四五六七八九十百千]+"
      ]
    },
    {
      "id": "VERIFY_MENTOR_STATUS",
      "description": "导师服务上线或可预约状态发布前必须核实。",
      "patterns": [
        "导师.{0,12}(已上线|已开放|现已开放|可预约|开放预约)",
        "(已上线|已开放|现已开放|可预约|开放预约).{0,12}导师"
      ]
    }
  ]
}
