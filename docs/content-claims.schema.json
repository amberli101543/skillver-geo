{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skillver.cn/schemas/content-claims.schema.json",
  "title": "Skillver GEO content claims policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "canonicalPositioning",
    "scanPaths",
    "allowedClaims",
    "prohibitedClaims",
    "pendingVerificationClaims"
  ],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "canonicalPositioning": {
      "type": "string",
      "const": "全面开放注册；邀请码仅用于赛事参与"
    },
    "scanPaths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "allowedClaims": {
      "$ref": "#/$defs/claimList"
    },
    "prohibitedClaims": {
      "$ref": "#/$defs/claimList"
    },
    "pendingVerificationClaims": {
      "$ref": "#/$defs/claimList"
    }
  },
  "$defs": {
    "claimList": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description", "patterns"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_-]+$"
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "patterns": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
